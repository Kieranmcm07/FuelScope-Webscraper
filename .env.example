# auto uses demo only when BOTH credentials are absent. live never falls back.
FUEL_MODE=auto
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
# Production endpoint verified against the official OpenAPI specification.
FUEL_FINDER_BASE_URL=https://www.fuel-finder.service.gov.uk
# Minimum 900 seconds for prices; station metadata cached for one hour.
REFRESH_SECONDS=1800
DATA_DIR=data
# No credentials are needed for postcode and town lookup.
GEOCODER_URL=https://api.postcodes.io
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
